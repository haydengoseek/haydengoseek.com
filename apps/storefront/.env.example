# Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Stripe (Payment Element on /checkout) — publishable key only; the secret key
# lives on the backend (apps/backend/.env), never here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sanity — project "HaydenGoSeek" (vy869vh5) under Mark's Sanity account.
# See sanity.cli.ts (already committed with this ID) — this env var is what
# the Next app itself reads, so a fresh checkout needs it set here too.
NEXT_PUBLIC_SANITY_PROJECT_ID=vy869vh5
NEXT_PUBLIC_SANITY_DATASET=production

# Resend (contact form)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
