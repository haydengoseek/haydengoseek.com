# Update to your Vercel storefront URL + Railway backend URL once deployed
STORE_CORS=https://haydengoseek-storefront.vercel.app,http://localhost:3000
ADMIN_CORS=https://haydengoseek-backend.up.railway.app,http://localhost:5173,http://localhost:9010
AUTH_CORS=https://haydengoseek-storefront.vercel.app,https://haydengoseek-backend.up.railway.app,http://localhost:5173,http://localhost:9010,http://localhost:3000

REDIS_URL=
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=

# Stripe — Medusa's @medusajs/payment-stripe provider (see medusa-config.ts).
# Test-mode keys first: https://dashboard.stripe.com/test/apikeys
# Webhook secret comes from the Stripe CLI (`stripe listen`) locally, or the
# Dashboard webhook endpoint once deployed.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Product images — Railway Volume (default; see medusa-config.ts). Set
# UPLOAD_DIR to the volume's mount path and MEDUSA_BACKEND_URL to this
# service's real public Railway URL once deployed, or uploaded files won't
# survive a redeploy and image URLs will point at localhost. Leave both
# unset for local dev — they fall back to ./static and localhost:9000.
UPLOAD_DIR=
MEDUSA_BACKEND_URL=

# Alternative to the volume above — S3-compatible storage (e.g. Supabase
# Storage, Cloudflare R2). Bucket must be public-read. Setting S3_FILE_URL
# switches medusa-config.ts over to this provider instead of the volume.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
